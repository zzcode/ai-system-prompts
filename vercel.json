{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/terms-of-service",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/terms-of-service.html",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/time-tools-index",
      "destination": "/date-time",
      "permanent": true
    },
    {
      "source": "/time-tools-index.html",
      "destination": "/date-time",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tools/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog-:slug*",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
