---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
const faqs=[
{q:"How is GPA calculated?",a:"GPA = total grade points ÷ total credit hours. Each letter grade has a point value (A=4.0, B=3.0, C=2.0, D=1.0, F=0). Multiply by credits, sum, divide by total credits."},
{q:"What is a 4.0 GPA scale?",a:"On a 4.0 scale: A=4.0, A-=3.7, B+=3.3, B=3.0, B-=2.7, C+=2.3, C=2.0, C-=1.7, D+=1.3, D=1.0, F=0.0. Some schools use +/- grades, others don't."},
{q:"What is a good GPA?",a:"3.0 (B average) is typically the minimum for many programs. 3.5+ is considered good, 3.7+ is excellent. Top graduate programs often expect 3.5+."}
];
const related=[
{href:"/math/grade-calculator",icon:"📝",title:"Grade Calculator",desc:"Calculate final grades"},
{href:"/math/percentage-calculator",icon:"%",title:"Percentage Calculator",desc:"Percent of a number"},
{href:"/math/fraction-calculator",icon:"½",title:"Fraction Calculator",desc:"Work with fractions"},
{href:"/math/average-calculator",icon:"x̄",title:"Average Calculator",desc:"Mean of numbers"},
{href:"/math/ratio-calculator",icon:"⚖️",title:"Ratio Calculator",desc:"Simplify ratios"},
{href:"/finance/tip-calculator",icon:"💵",title:"Tip Calculator",desc:"Tip & split bill"}
];
---
<CalculatorLayout title="GPA Calculator - Calculate Your Grade Point Average" h1="GPA Calculator" description="Free GPA calculator. Calculate your Grade Point Average on a 4.0 scale. Add courses, credits, and grades. Instant results. No sign-up." subtitle="Calculate your GPA on a 4.0 scale. Add courses with credits and letter grades." category="Math" categoryHref="/math" appCategory="EducationApplication" faqs={faqs} relatedTools={related}>
<div slot="calculator">
<div id="gpa-courses">
<div class="input-row" style="grid-template-columns:2fr 1fr 1fr 40px;gap:8px;align-items:end;margin-bottom:8px;">
<div style="font-size:0.82rem;font-weight:600;color:var(--text-muted);">Course name</div>
<div style="font-size:0.82rem;font-weight:600;color:var(--text-muted);">Credits</div>
<div style="font-size:0.82rem;font-weight:600;color:var(--text-muted);">Grade</div>
<div></div>
</div>
<div id="gpa-rows"></div>
</div>
<button class="btn btn-ghost" id="gpa-add" type="button" style="margin-top:10px;">+ Add course</button>
<div class="result-panel" style="margin-top:20px;">
<div class="result-main"><div class="result-label">Your GPA</div><div class="result-value" id="gpa-val">3.50</div><div class="result-sub" id="gpa-sub">12 credits</div></div>
</div>
</div>
<script is:inline>
(function(){
var grades={'A+':4.0,'A':4.0,'A-':3.7,'B+':3.3,'B':3.0,'B-':2.7,'C+':2.3,'C':2.0,'C-':1.7,'D+':1.3,'D':1.0,'F':0.0};
var courses=[{name:'Math',credits:3,grade:'A'},{name:'English',credits:3,grade:'B+'},{name:'Science',credits:4,grade:'A-'},{name:'History',credits:2,grade:'B'}];
var container=document.getElementById('gpa-rows');
function render(){
container.innerHTML='';
courses.forEach(function(c,i){
var div=document.createElement('div');
div.className='input-row';
div.style.cssText='grid-template-columns:2fr 1fr 1fr 40px;gap:8px;margin-bottom:8px;';
div.innerHTML='<input type="text" value="'+c.name+'" data-i="'+i+'" data-f="name" placeholder="Course" style="padding:8px 10px;font-size:0.9rem;border:1.5px solid var(--border);border-radius:8px;">'+
'<input type="number" value="'+c.credits+'" data-i="'+i+'" data-f="credits" min="0" style="padding:8px 10px;font-size:0.9rem;border:1.5px solid var(--border);border-radius:8px;">'+
'<select data-i="'+i+'" data-f="grade" style="padding:8px 10px;font-size:0.9rem;border:1.5px solid var(--border);border-radius:8px;">'+
Object.keys(grades).map(function(g){return '<option value="'+g+'"'+(g===c.grade?' selected':'')+'>'+g+'</option>';}).join('')+'</select>'+
'<button data-i="'+i+'" class="gpa-del" style="border:none;background:none;color:var(--text-muted);cursor:pointer;font-size:1.2rem;padding:4px;">×</button>';
container.appendChild(div);
});
container.querySelectorAll('input,select').forEach(function(el){el.addEventListener('input',function(){var i=parseInt(el.getAttribute('data-i'),10);var f=el.getAttribute('data-f');courses[i][f]=f==='credits'?parseFloat(el.value)||0:el.value;calc();});});
container.querySelectorAll('.gpa-del').forEach(function(b){b.addEventListener('click',function(){courses.splice(parseInt(b.getAttribute('data-i'),10),1);render();calc();});});
calc();
}
function calc(){
var totalPoints=0,totalCredits=0;
courses.forEach(function(c){totalPoints+=grades[c.grade]*c.credits;totalCredits+=c.credits;});
var gpa=totalCredits>0?totalPoints/totalCredits:0;
document.getElementById('gpa-val').textContent=gpa.toFixed(2);
document.getElementById('gpa-sub').textContent=totalCredits+' credits · '+courses.length+' courses';
}
document.getElementById('gpa-add').addEventListener('click',function(){courses.push({name:'',credits:3,grade:'A'});render();});
render();
})();
</script>
<section class="content-section">
<h2>GPA Scale (4.0)</h2>
<table class="ref-table"><thead><tr><th>Grade</th><th>Points</th><th>Percentage</th></tr></thead><tbody>
<tr><td>A / A+</td><td>4.0</td><td>93–100%</td></tr>
<tr><td>A-</td><td>3.7</td><td>90–92%</td></tr>
<tr><td>B+</td><td>3.3</td><td>87–89%</td></tr>
<tr><td>B</td><td>3.0</td><td>83–86%</td></tr>
<tr><td>B-</td><td>2.7</td><td>80–82%</td></tr>
<tr><td>C+</td><td>2.3</td><td>77–79%</td></tr>
<tr><td>C</td><td>2.0</td><td>73–76%</td></tr>
<tr><td>D</td><td>1.0</td><td>60–66%</td></tr>
<tr><td>F</td><td>0.0</td><td>Below 60%</td></tr>
</tbody></table>
</section>
</CalculatorLayout>
