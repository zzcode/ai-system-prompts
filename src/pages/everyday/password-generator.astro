---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
const faqs = [
  { q: "How do I create a strong password?", a: "Use at least 12 characters, mix uppercase, lowercase, numbers, and symbols. Avoid common words, names, and sequences. This generator creates random passwords that are extremely difficult to crack." },
  { q: "What makes a password secure?", a: "Length and randomness. A 16-character random password has over 95^16 possible combinations — billions of years to brute force. Avoid dictionary words, personal info, and reused passwords." },
  { q: "Should I use a password manager?", a: "Yes. A password manager lets you use unique, strong passwords for every account without memorizing them. Generate a strong master password, then let the manager create and store the rest." },
  { q: "How long should my password be?", a: "Minimum 12 characters for most accounts; 16+ for sensitive accounts like email and banking. Each additional character exponentially increases security." },
  { q: "Is this password generator safe?", a: "Yes. Passwords are generated entirely in your browser using JavaScript's crypto.getRandomValues(). Nothing is sent to any server, stored, or logged." },
  { q: "What are special characters?", a: "Special characters include symbols like !@#$%^&*()_+-=[]{}|;:',.<>?/~`. Including them dramatically increases password strength." }
];
const related = [
  { href: "/everyday/word-counter", icon: "📝", title: "Word Counter", desc: "Count words & characters" },
  { href: "/everyday/random-number-generator", icon: "🎲", title: "Random Number Generator", desc: "Generate random numbers" },
  { href: "/everyday/case-converter", icon: "Aa", title: "Case Converter", desc: "Change text case" },
  { href: "/math/percentage-calculator", icon: "%", title: "Percentage Calculator", desc: "Percent of a number" },
  { href: "/finance/tip-calculator", icon: "💵", title: "Tip Calculator", desc: "Tip & split the bill" },
  { href: "/health/bmi-calculator", icon: "⚖️", title: "BMI Calculator", desc: "Body mass index" }
];
---
<CalculatorLayout
  title="Password Generator - Create Strong Random Passwords Online"
  h1="Password Generator"
  description="Free password generator. Create strong, random, secure passwords with custom length, uppercase, lowercase, numbers, and symbols. No sign-up, 100% private."
  subtitle="Generate strong, random passwords instantly. Customize length and character types for maximum security."
  category="Everyday"
  categoryHref="/everyday"
  appCategory="UtilitiesApplication"
  faqs={faqs}
  relatedTools={related}
>
  <div slot="calculator">
    <div class="calc-grid">
      <div>
        <div class="field">
          <label for="pw-length">Password length: <span id="pw-len-val">16</span></label>
          <input type="range" id="pw-length" min="8" max="64" value="16" style="width:100%;" />
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:18px;">
          <label style="display:flex;align-items:center;gap:8px;font-size:0.9rem;cursor:pointer;"><input type="checkbox" id="pw-upper" checked /> Uppercase (A-Z)</label>
          <label style="display:flex;align-items:center;gap:8px;font-size:0.9rem;cursor:pointer;"><input type="checkbox" id="pw-lower" checked /> Lowercase (a-z)</label>
          <label style="display:flex;align-items:center;gap:8px;font-size:0.9rem;cursor:pointer;"><input type="checkbox" id="pw-num" checked /> Numbers (0-9)</label>
          <label style="display:flex;align-items:center;gap:8px;font-size:0.9rem;cursor:pointer;"><input type="checkbox" id="pw-sym" checked /> Symbols (!@#$)</label>
        </div>
        <button class="btn btn-primary" id="pw-gen" type="button" style="width:100%;">🔄 Generate Password</button>
      </div>
      <div class="result-panel">
        <div class="result-main">
          <div class="result-label">Your Password</div>
          <div id="pw-output" style="font-size:1.3rem;font-weight:700;color:var(--primary-dark);word-break:break-all;text-align:center;padding:12px;font-family:var(--font-mono);min-height:48px;">Click generate</div>
        </div>
        <div class="result-rows" id="pw-rows"></div>
        <button class="btn btn-ghost" id="pw-copy" type="button" style="width:100%;margin-top:12px;">📋 Copy to clipboard</button>
      </div>
    </div>
  </div>
  <script is:inline>
    (function(){
      var up='ABCDEFGHIJKLMNOPQRSTUVWXYZ',lo='abcdefghijklmnopqrstuvwxyz',nm='0123456789',sy='!@#$%^&*()_+-=[]{}|;:,.<>?';
      var lenEl=document.getElementById('pw-length'),lenVal=document.getElementById('pw-len-val');
      var out=document.getElementById('pw-output'),rows=document.getElementById('pw-rows');
      lenEl.addEventListener('input',function(){lenVal.textContent=lenEl.value;});
      function rint(max){var a=new Uint32Array(1);crypto.getRandomValues(a);return a[0]%max;}
      function gen(){
        var pool='';if(document.getElementById('pw-upper').checked)pool+=up;
        if(document.getElementById('pw-lower').checked)pool+=lo;
        if(document.getElementById('pw-num').checked)pool+=nm;
        if(document.getElementById('pw-sym').checked)pool+=sy;
        if(!pool){out.textContent='Select at least one type';rows.innerHTML='';return;}
        var n=parseInt(lenEl.value,10),pw='';
        for(var i=0;i<n;i++)pw+=pool[rint(pool.length)];
        out.textContent=pw;
        var entropy=Math.log2(pool.length)*n;
        rows.innerHTML='<div class="result-row"><span class="rr-label">Length</span><span class="rr-value">'+n+' chars</span></div>'+
          '<div class="result-row"><span class="rr-label">Entropy</span><span class="rr-value">'+Math.round(entropy)+' bits</span></div>'+
          '<div class="result-row"><span class="rr-label">Strength</span><span class="rr-value">'+(entropy>=100?'Very strong':entropy>=60?'Strong':entropy>=36?'Moderate':'Weak')+'</span></div>';
      }
      document.getElementById('pw-gen').addEventListener('click',gen);
      document.getElementById('pw-copy').addEventListener('click',function(){
        if(out.textContent&&out.textContent!=='Click generate'){navigator.clipboard.writeText(out.textContent).then(function(){var b=document.getElementById('pw-copy');b.textContent='✅ Copied!';setTimeout(function(){b.textContent='📋 Copy to clipboard';},2000);});}
      });
      gen();
    })();
  </script>
  <section class="content-section">
    <h2>How to Use the Password Generator</h2>
    <p>Set your desired length (8–64 characters), choose which character types to include, and click Generate. The password is created locally using cryptographically secure random values — it never leaves your browser.</p>
    <h2>What Makes a Strong Password?</h2>
    <div class="formula-box">Strength = Length × Character Variety × Randomness</div>
    <p>A 16-character password using all four character types has over 95¹⁶ possible combinations — roughly 10³¹ options. At a billion guesses per second, brute-forcing it would take longer than the age of the universe.</p>
    <h2>Password Strength Reference</h2>
    <table class="ref-table"><thead><tr><th>Length</th><th>Combinations</th><th>Time to Crack*</th></tr></thead><tbody>
      <tr><td>8 chars</td><td>~6 quadrillion</td><td>Hours</td></tr>
      <tr><td>12 chars</td><td>~542 sextillion</td><td>Centuries</td></tr>
      <tr><td>16 chars</td><td>~4 vigintillion</td><td>Billions of years</td></tr>
      <tr><td>20+ chars</td><td>Astronomical</td><td>Effectively uncrackable</td></tr>
    </tbody></table>
    <p style="font-size:0.82rem;color:var(--text-muted);">*Estimated at 1 billion guesses/second with all character types.</p>
  </section>
</CalculatorLayout>
