---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'How Much Unemployment Will I Get?';
const description = 'Understand how U.S. unemployment benefits are calculated, why the weekly amount varies by state, and how to find your state\u2019s official program and benefit limits.';
const canonical = 'https://www.kodatools.com/guides/how-much-unemployment-will-i-get';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How much unemployment will I get?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Your weekly unemployment benefit depends on your state and your earnings during a recent base period. Each state sets its own formula, weekly maximum, and benefit duration, so the amount can differ significantly from one state to the next.'
      }
    },
    {
      '@type': 'Question',
      name: 'How is unemployment calculated?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Most states base your benefit on wages earned during a one-year base period, typically the first four of the last five completed calendar quarters. Your weekly amount is usually a percentage of those wages, capped at the state\u2019s maximum.'
      }
    },
    {
      '@type': 'Question',
