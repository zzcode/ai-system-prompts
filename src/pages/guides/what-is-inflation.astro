---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'What Is Inflation and How Does It Affect My Money?';
const description = 'Understand what inflation is, why it happens, how it erodes purchasing power, and how to calculate its real impact on your savings.';
const canonical = 'https://www.kodatools.com/guides/what-is-inflation';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is inflation?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Inflation is the rate at which the general level of prices for goods and services rises, reducing the purchasing power of money. As prices go up, each dollar buys less than it did before.'
      }
    },
    {
      '@type': 'Question',
      name: 'How does inflation affect my savings?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Inflation erodes the real value of cash. If your savings earn less than the inflation rate, you lose purchasing power over time. Money that sits in cash slowly buys less each year.'
      }
    },
    {
      '@type': 'Question',
      name: 'How can I protect my money from inflation?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Investing in assets that historically outpace inflation, such as stocks, real estate, or inflation-protected bonds, can help. Keeping large amounts in low-interest cash leaves you exposed to erosion.'
      }
    }
