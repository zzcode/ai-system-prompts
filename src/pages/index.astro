---
import BaseLayout from '../layouts/BaseLayout.astro';
import allTools from '../data/tools.json';

const categories = [
  {
    href: '/finance', icon: '💰', name: 'Finance', color: '#b45309', bg: '#fef3c7',
    desc: 'Mortgage, loan, interest & money tools',
    tools: [
      { href: '/finance/mortgage-calculator', name: 'Mortgage Calculator' },
      { href: '/finance/loan-calculator', name: 'Loan Calculator' },
      { href: '/finance/compound-interest-calculator', name: 'Compound Interest' },
      { href: '/finance/tip-calculator', name: 'Tip Calculator' }
    ]
  },
  {
    href: '/health', icon: '❤️', name: 'Health', color: '#dc2626', bg: '#fee2e2',
    desc: 'BMI, calorie & fitness calculators',
    tools: [
      { href: '/health/bmi-calculator', name: 'BMI Calculator' },
      { href: '/health/calorie-calculator', name: 'Calorie Calculator' }
    ]
  },
  {
    href: '/math', icon: '🧮', name: 'Math', color: '#2563eb', bg: '#dbeafe',
    desc: 'Percentage, fractions & everyday math',
    tools: [
      { href: '/math/percentage-calculator', name: 'Percentage Calculator' }
    ]
  },
  {
    href: '/date-time', icon: '📅', name: 'Date & Time', color: '#7c3aed', bg: '#ede9fe',
    desc: 'Age, dates & time calculations',
    tools: [
      { href: '/date-time/age-calculator', name: 'Age Calculator' }
    ]
  }
];

categories.push(
  { href: '/construction', icon: '📐', name: 'Construction', color: '#0f766e', bg: '#ccfbf1', desc: 'Area, concrete, paint and tile estimates', tools: allTools.filter(t => t.href.startsWith('/construction/')).map(t => ({href:t.href,name:t.name})) },
  { href: '/converters', icon: '⇄', name: 'Converters', color: '#0f766e', bg: '#ccfbf1', desc: 'Excel to JSON and measurement conversions', tools: allTools.filter(t => t.href.startsWith('/converters/') || t.categoryHref === '/converters').map(t => ({href:t.href,name:t.name})) },
  { href: '/everyday', icon: '✦', name: 'Everyday', color: '#0f766e', bg: '#ccfbf1', desc: 'Text, passwords, QR codes and random numbers', tools: allTools.filter(t => t.href.startsWith('/everyday/')).slice(0,4).map(t => ({href:t.href,name:t.name})) }
);
const popular = [
  { href: '/math/percentage-calculator', icon: '%', name: 'Percentage Calculator', desc: 'Percent of a number, change & more', color: '#2563eb', bg: '#dbeafe' },
  { href: '/finance/mortgage-calculator', icon: '🏠', name: 'Mortgage Calculator', desc: 'Monthly payment & total interest', color: '#b45309', bg: '#fef3c7' },
  { href: '/health/bmi-calculator', icon: '⚖️', name: 'BMI Calculator', desc: 'Body mass index & weight category', color: '#dc2626', bg: '#fee2e2' },
  { href: '/date-time/age-calculator', icon: '🎂', name: 'Age Calculator', desc: 'Exact age in years, months, days', color: '#7c3aed', bg: '#ede9fe' },
  { href: '/finance/compound-interest-calculator', icon: '📈', name: 'Compound Interest', desc: 'Watch your savings grow', color: '#059669', bg: '#d1fae5' },
  { href: '/finance/tip-calculator', icon: '💵', name: 'Tip Calculator', desc: 'Tip & split the bill easily', color: '#db2777', bg: '#fce7f3' },
  { href: '/health/calorie-calculator', icon: '🔥', name: 'Calorie Calculator', desc: 'Daily calorie needs (BMR & TDEE)', color: '#dc2626', bg: '#fee2e2' },
  { href: '/finance/loan-calculator', icon: '💳', name: 'Loan Calculator', desc: 'Payment & total cost of any loan', color: '#b45309', bg: '#fef3c7' }
];

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "KodaTools",
  "url": "https://www.kodatools.com",
  "description": "Material planning, file conversion and everyday calculators.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://www.kodatools.com/?s={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};
---

<BaseLayout
  title="Material Planner & Free Online Calculators | KodaTools"
  description="Plan tile, paint and concrete purchases across multiple areas. Save and export a material list, or use free calculators for money, dates and everyday tasks."
  schema={orgSchema}
>
  <!-- Hero -->
  <section class="project-hero">
    <div class="container">
      <h1>Plan your materials<br/>before you buy.</h1>
      <p class="hero-intro">Combine tile, paint and concrete estimates across your project. Get whole-package quantities and a shopping list you can save, print or take to your supplier.</p>
      <a href="/construction/material-planner" class="hero-cta">Build a material list</a>
      <p class="hero-note">Free to use. No account. Your measurements stay in your browser.</p>
      <div class="hero-search-wrap">
        <label for="hero-search">Or find an everyday calculator</label>
        <input id="hero-search" type="search" aria-label={`Search all ${allTools.length} tools`} aria-controls="search-results" placeholder="Search tools (e.g. tile, loan, age)" />
      </div>
      <div style="margin-top:22px;font-size:0.85rem;opacity:0.85;">Popular:&nbsp;
        <a href="/math/percentage-calculator" style="color:#fff;text-decoration:underline;">Percentage</a> ·
        <a href="/finance/mortgage-calculator" style="color:#fff;text-decoration:underline;">Mortgage</a> ·
        <a href="/health/bmi-calculator" style="color:#fff;text-decoration:underline;">BMI</a> ·
        <a href="/date-time/age-calculator" style="color:#fff;text-decoration:underline;">Age</a> ·
        <a href="/finance/tip-calculator" style="color:#fff;text-decoration:underline;">Tip</a>
      </div>
    </div>
  </section>

  <div class="container">
    <section id="search-section" hidden class="search-section" aria-labelledby="search-heading">
      <h2 id="search-heading">Search results</h2>
      <p id="search-status" role="status" aria-live="polite"></p>
      <div id="search-results" class="tool-grid">
        {allTools.map((tool) => <a href={tool.href} class="tool-card" data-search={`${tool.name} ${tool.description} ${tool.category}`}><span class="tc-icon" aria-hidden="true">{tool.icon}</span><span><span class="tc-title">{tool.name}</span><span class="tc-desc">{tool.desc}</span></span></a>)}
      </div>
    </section>
    <!-- Popular tools -->
    <section style="padding:44px 0 8px;">
      <h2 style="font-size:1.5rem;font-weight:700;margin-bottom:20px;">Everyday Calculators</h2>
      <div class="tool-grid" style="grid-template-columns:repeat(4,1fr);" id="popular-grid">
        {popular.map((t) => (
          <a href={t.href} class="tool-card">
            <span class="tc-icon" style={`background:${t.bg};color:${t.color};`}>{t.icon}</span>
            <span>
              <span class="tc-title">{t.name}</span>
              <span class="tc-desc">{t.desc}</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="content-section" aria-labelledby="planning-heading">
      <h2 id="planning-heading">Start with the question you need to answer</h2>
      <div class="tool-grid">
        <a href="/finance/loan-calculator" class="tool-card"><span><span class="tc-title">What will this loan cost each month?</span><span class="tc-desc">Compare payment terms, try a zero-interest example and see the full repayment cost.</span></span></a>
        <a href="/finance/compound-interest-calculator" class="tool-card"><span><span class="tc-title">What difference would monthly savings make?</span><span class="tc-desc">Compare regular contributions with a single deposit and follow the yearly balance.</span></span></a>
        <a href="/date-time/age-calculator" class="tool-card"><span><span class="tc-title">How old will I be on a specific date?</span><span class="tc-desc">Use a target date, explore a leap-day example and count calendar days.</span></span></a>
        <a href="/construction/concrete-calculator" class="tool-card"><span><span class="tc-title">How many bags of concrete do I need?</span><span class="tc-desc">Convert slab dimensions to cubic yards and bag counts with an adjustable allowance.</span></span></a>
        <a href="/construction/tile-calculator" class="tool-card"><span><span class="tc-title">How many boxes of tile do I need?</span><span class="tc-desc">Use your tile size, pack count and allowance to estimate whole boxes and material cost.</span></span></a>
        <a href="/construction/paint-calculator" class="tool-card"><span><span class="tc-title">How much paint for two coats?</span><span class="tc-desc">Subtract openings, enter your paint's coverage and estimate whole gallons.</span></span></a>
      </div>
    </section>

    <!-- Categories -->
    <section style="padding:36px 0 20px;">
      <h2 style="font-size:1.5rem;font-weight:700;margin-bottom:20px;">Browse by Category</h2>
      <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:16px;" class="cat-home-grid">
        {categories.map((c) => (
          <div class="card" style="padding:24px;">
            <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;">
              <span style={`width:42px;height:42px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.3rem;background:${c.bg};color:${c.color};`}>{c.icon}</span>
              <div>
                <div style="font-weight:700;font-size:1.05rem;">{c.name}</div>
                <div style="font-size:0.82rem;color:var(--text-muted);">{c.desc}</div>
              </div>
            </div>
            <div style="display:flex;flex-direction:column;gap:2px;margin-top:10px;">
              {c.tools.map((t) => (
                <a href={t.href} style="font-size:0.9rem;color:var(--text-secondary);text-decoration:none;padding:5px 0;border-bottom:1px dashed var(--border-light);">{t.name} →</a>
              ))}
              <a href={c.href} style="font-size:0.85rem;color:var(--primary);font-weight:600;text-decoration:none;padding-top:8px;">View all {c.name} →</a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Why -->
    <section class="content-section" style="margin-top:24px;">
      <h2>Why KodaTools?</h2>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:8px;" class="why-home-grid">
        <div><div style="font-size:1.6rem;margin-bottom:6px;">⚡</div><strong>Instant results</strong><p style="margin-top:4px;">Calculations happen as you type — no buttons, no page reloads, no waiting.</p></div>
        <div><div style="font-size:1.6rem;margin-bottom:6px;">🔒</div><strong>Private by design</strong><p style="margin-top:4px;">Calculations stay in your browser. Save a material plan on your device only when you choose.</p></div>
        <div><div style="font-size:1.6rem;margin-bottom:6px;">🆓</div><strong>Always free</strong><p style="margin-top:4px;">No accounts, no subscriptions, no hidden fees. Every tool is free to use.</p></div>
      </div>
    </section>
  </div>

  <script is:inline>
    (function () {
      var input = document.getElementById('hero-search');
      var section = document.getElementById('search-section');
      var cards = Array.from(document.querySelectorAll('#search-results .tool-card'));
      function search() {
        var q = input.value.trim().toLowerCase();
        section.hidden = !q;
        var matches = 0;
        cards.forEach(function(card) {
          var visible = q.split(/\s+/).every(function(word) { return card.dataset.search.toLowerCase().includes(word); });
          card.hidden = !visible;
          if (visible) matches++;
        });
        document.getElementById('search-status').textContent = matches ? matches + (matches === 1 ? ' tool found' : ' tools found') : 'No tools found. Try a shorter term, such as loan, date or QR.';
      }
      input.addEventListener('input', search);
      input.value = new URLSearchParams(location.search).get('s') || '';
      search();
    })();
  </script>

  <style>
    .project-hero {background:#115e59;color:#fff;padding:52px 0 40px;}
    .project-hero h1 {font-size:clamp(2.25rem,5vw,3.4rem);line-height:1.1;font-weight:750;letter-spacing:-.025em;margin-bottom:20px;max-width:22ch;}
    .hero-intro {font-size:1.1rem;max-width:58ch;color:#e6f4f1;margin-bottom:24px;}
    .hero-cta {display:inline-block;background:white;color:#115e59;font-weight:700;padding:13px 20px;border-radius:8px;text-decoration:none;}
    .hero-note {font-size:.85rem;color:#e6f4f1;margin:12px 0 28px;}
    .hero-search-wrap {max-width:520px;}
    .hero-search-wrap label {display:block;margin-bottom:8px;font-size:.9rem;}
    #hero-search {width:100%;padding:13px 16px;font-size:1rem;border:1px solid #b5d9d1;border-radius:8px;}
    @media (max-width: 860px) {
      #popular-grid { grid-template-columns: repeat(2,1fr) !important; }
      .cat-home-grid { grid-template-columns: 1fr !important; }
      .why-home-grid { grid-template-columns: 1fr !important; }
    }
    @media (max-width: 480px) {
      #popular-grid { grid-template-columns: 1fr !important; }
    }
  </style>
</BaseLayout>
