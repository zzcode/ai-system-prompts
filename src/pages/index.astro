---
import BaseLayout from '../layouts/BaseLayout.astro';

const featured = [
  { href: '/finance/escrow-analysis-checker', category: 'U.S. HOMEOWNERS', title: 'Escrow Analysis Checker', description: 'Break down a mortgage escrow increase. See what changed in taxes and insurance, what is temporary, and what to verify on your statement.', action: 'Check an escrow statement' },
  { href: '/finance/unemployment-benefits-by-state', category: 'U.S. JOB LOSS', title: 'Unemployment Benefits by State', description: 'Find the official unemployment agency for any U.S. state or D.C. Compare published weekly limits and durations where we’ve verified them.', action: 'Look up a state' },
];
const description = 'Check why your U.S. mortgage escrow payment changed, find your state unemployment agency, and compare verified benefit limits for selected states.';
---
<BaseLayout title="Escrow, Unemployment & Practical Tools | KodaTools" description={description} focusedHome schema={{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'KodaTools', url: 'https://www.kodatools.com', description }}>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">FREE TOOLS · NO ACCOUNT REQUIRED</p>
      <h1>Check the numbers before you make a decision.</h1>
      <p class="intro">Check why your U.S. mortgage escrow payment changed or find the right state agency for unemployment benefits.</p>
      <div class="featured">
        {featured.map((tool) => <article class="feature card">
          <p class="eyebrow">{tool.category}</p>
          <h2>{tool.title}</h2>
          <p>{tool.description}</p>
          <a class="action" href={tool.href}>{tool.action} <span aria-hidden="true">→</span></a>
        </article>)}
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .hero { padding: clamp(38px, 7vw, 74px) 0 42px; background: radial-gradient(ellipse at 100% 0, #d2faed, transparent 62%), #eff8f5; border-bottom: 1px solid #d8e9e5; }
  .eyebrow { font-size: .75rem; font-weight: 750; letter-spacing: .12em; color: var(--primary-dark); }
  h1 { max-width: 21ch; margin: 10px 0 14px; font-size: clamp(2.05rem, 5.7vw, 4.15rem); line-height: 1.06; letter-spacing: -.048em; }
  .intro { max-width: 60ch; color: var(--text-secondary); font-size: 1.12rem; }
  .featured { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-top: 32px; }
  .feature { padding: clamp(18px, 3vw, 28px); }
  .feature { display: flex; flex-direction: column; align-items: flex-start; }
  .feature h2 { margin: 6px 0; font-size: clamp(1.25rem, 2.5vw, 1.65rem); line-height: 1.25; }
  .feature p:not(.eyebrow) { color: var(--text-secondary); }
  .action { margin-top: auto; padding: 12px 16px; background: var(--primary-dark); color: white; text-decoration: none; border-radius: 8px; font-weight: 700; }
  .feature p:not(.eyebrow) { margin-bottom: 20px; }
  .action:hover { background: #134e4a; }
  @media (max-width: 680px) { .featured { grid-template-columns: 1fr; } }
</style>