---
import BaseLayout from '../../layouts/BaseLayout.astro';
import allTools from '../../data/tools.json';
import { conversions, formatNum } from '../../data/conversions.js';

const tools = allTools.filter((tool) => tool.href.startsWith('/converters/'));
---

<BaseLayout
  title="Unit Converters - Length, Weight, Temperature & More"
  description="Free unit converters: length, weight, temperature and more. Convert cm to inches, kg to lbs, Fahrenheit to Celsius. Instant results, no sign-up."
>
  <div class="container">
    <div class="page-head">
      <nav class="breadcrumb"><a href="/">Home</a><span class="sep">/</span><span>Converters</span></nav>
      <h1>Unit Converters</h1>
      <p class="subtitle">Convert between units of length, weight, temperature, and more — instantly.</p>
    </div>
    <div class="tool-grid">
      {tools.map((t) => (
        <a href={t.href} class="tool-card">
          <span class="tc-icon" style="background:#d1fae5;color:#059669;">{t.icon}</span>
          <span>
            <span class="tc-title">{t.name}</span>
            <span class="tc-desc">{t.desc}</span>
          </span>
        </a>
      ))}
    </div>
    <section class="content-section" style="margin-top:32px;">
      <h2>Fast, Accurate Conversions</h2>
      <p>Our converters handle the most common everyday conversions — length, weight, and temperature — with instant results as you type. Results update in real time and show the same value across several units at once.</p>
    </section>
    <section class="content-section" aria-labelledby="conversion-directory">
      <h2 id="conversion-directory">Browse Common Conversions</h2>
      <p>Choose a conversion to see the answer, formula, nearby values, and an interactive converter.</p>
      {conversions.map((conversion) => (
        <section class="conversion-group">
          <h3>{conversion.fromLabel} to {conversion.toLabel}</h3>
          <ul class="conversion-links">
            {conversion.values.map((value) => (
              <li><a href={`/convert/${value}-${conversion.baseSlug}`}>{formatNum(value)} {conversion.fromUnit} to {conversion.toUnit}</a></li>
            ))}
          </ul>
        </section>
      ))}
    </section>
  </div>
</BaseLayout>

<style>
  .conversion-group { margin-top: 24px; }
  .conversion-links { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 8px; list-style: none; padding: 0; }
  .conversion-links a { display: block; padding: 10px 12px; border: 1px solid var(--border); border-radius: 8px; color: var(--primary); }
  .conversion-links a:hover { background: var(--primary-soft); }
  .conversion-links a:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
</style>
