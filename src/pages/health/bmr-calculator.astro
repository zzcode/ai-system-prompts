---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
const faqs=[
{q:"What is BMR?",a:"BMR (Basal Metabolic Rate) is the number of calories your body burns at complete rest to maintain basic life functions like breathing, circulation, and cell production."},
{q:"What is the Mifflin-St Jeor equation?",a:"It's the most accurate BMR formula for most people: Men: BMR = 10×kg + 6.25×cm − 5×age + 5. Women: BMR = 10×kg + 6.25×cm − 5×age − 161."},
{q:"What's the difference between BMR and TDEE?",a:"BMR is calories burned at rest. TDEE (Total Daily Energy Expenditure) multiplies BMR by an activity factor to estimate total daily calorie burn."},
{q:"Is this BMR calculator accurate?",a:"Mifflin-St Jeor is considered the most reliable BMR equation for the general population, but all estimates have a margin of error of ~5–10%."}
];
const related=[
{href:"/health/calorie-calculator",icon:"🔥",title:"Calorie Calculator",desc:"Daily calorie needs (TDEE)"},
{href:"/health/tdee-calculator",icon:"⚡",title:"TDEE Calculator",desc:"Total daily energy expenditure"},
{href:"/health/bmi-calculator",icon:"⚖️",title:"BMI Calculator",desc:"Body mass index"},
{href:"/health/macro-calculator",icon:"🥗",title:"Macro Calculator",desc:"Protein, carbs & fat"},
{href:"/health/body-fat-calculator",icon:"📏",title:"Body Fat Calculator",desc:"Estimate body fat %"},
{href:"/health/ideal-weight-calculator",icon:"🎯",title:"Ideal Weight",desc:"Healthy weight range"}
];
---
<CalculatorLayout title="BMR Calculator - Basal Metabolic Rate (Mifflin-St Jeor)" h1="BMR Calculator" description="Free BMR calculator. Calculate your Basal Metabolic Rate using the Mifflin-St Jeor equation. Find out how many calories you burn at rest. No sign-up." subtitle="Calculate your Basal Metabolic Rate — the calories your body burns at complete rest." category="Health" categoryHref="/health" appCategory="HealthApplication" faqs={faqs} relatedTools={related}>
<div slot="calculator">
<div class="segmented" style="margin-bottom:24px;"><button class="bmr-unit active" data-unit="metric">Metric</button><button class="bmr-unit" data-unit="imperial">Imperial</button></div>
<div class="calc-grid">
<div>
<div class="input-row">
<div class="field"><label>Gender</label><div class="segmented" id="bmr-gender"><button data-g="male" class="active">Male</button><button data-g="female">Female</button></div></div>
<div class="field"><label for="bmr-age">Age</label><div class="input-affix has-suffix"><input type="number" id="bmr-age" value="30" /><span class="suffix">yrs</span></div></div>
</div>
<div id="bmr-metric"><div class="input-row"><div class="field"><label for="bmr-h-cm">Height</label><div class="input-affix has-suffix"><input type="number" id="bmr-h-cm" value="175" /><span class="suffix">cm</span></div></div><div class="field"><label for="bmr-w-kg">Weight</label><div class="input-affix has-suffix"><input type="number" id="bmr-w-kg" value="70" /><span class="suffix">kg</span></div></div></div></div>
<div id="bmr-imperial" style="display:none;"><div class="input-row"><div class="field"><label for="bmr-h-ft">Height (ft)</label><input type="number" id="bmr-h-ft" value="5" /></div><div class="field"><label for="bmr-h-in">Height (in)</label><input type="number" id="bmr-h-in" value="9" /></div></div><div class="field"><label for="bmr-w-lb">Weight</label><div class="input-affix has-suffix"><input type="number" id="bmr-w-lb" value="154" /><span class="suffix">lb</span></div></div></div>
</div>
<div class="result-panel">
<div class="result-main"><div class="result-label">Your BMR</div><div class="result-value" id="bmr-val">1,680</div><div class="result-sub">calories/day at rest</div></div>
<div class="result-rows" id="bmr-rows"></div>
</div>
</div>
</div>
<script is:inline>
(function(){
var unit='metric',gender='male';
function num(id){var v=parseFloat(document.getElementById(id).value);return isNaN(v)?0:v;}
function row(l,v){return '<div class="result-row"><span class="rr-label">'+l+'</span><span class="rr-value">'+v+'</span></div>';}
function calc(){
var age=num('bmr-age'),kg,cm;
if(unit==='metric'){cm=num('bmr-h-cm');kg=num('bmr-w-kg');}
else{var inT=num('bmr-h-ft')*12+num('bmr-h-in');cm=inT*2.54;kg=num('bmr-w-lb')*0.453592;}
if(!age||!cm||!kg){document.getElementById('bmr-val').textContent='—';return;}
var bmr=gender==='male'?(10*kg+6.25*cm-5*age+5):(10*kg+6.25*cm-5*age-161);
document.getElementById('bmr-val').textContent=Math.round(bmr).toLocaleString();
document.getElementById('bmr-rows').innerHTML=row('Sedentary (×1.2)',Math.round(bmr*1.2).toLocaleString()+' cal')+row('Light (×1.375)',Math.round(bmr*1.375).toLocaleString()+' cal')+row('Moderate (×1.55)',Math.round(bmr*1.55).toLocaleString()+' cal')+row('Very active (×1.725)',Math.round(bmr*1.725).toLocaleString()+' cal');
}
document.querySelectorAll('.bmr-unit').forEach(function(b){b.addEventListener('click',function(){document.querySelectorAll('.bmr-unit').forEach(function(x){x.classList.remove('active');});b.classList.add('active');unit=b.getAttribute('data-unit');document.getElementById('bmr-metric').style.display=unit==='metric'?'':'none';document.getElementById('bmr-imperial').style.display=unit==='imperial'?'':'none';calc();});});
document.querySelectorAll('#bmr-gender button').forEach(function(b){b.addEventListener('click',function(){document.querySelectorAll('#bmr-gender button').forEach(function(x){x.classList.remove('active');});b.classList.add('active');gender=b.getAttribute('data-g');calc();});});
document.querySelectorAll('#bmr-age,#bmr-h-cm,#bmr-w-kg,#bmr-h-ft,#bmr-h-in,#bmr-w-lb').forEach(function(el){el.addEventListener('input',calc);});
calc();
})();
</script>
<section class="content-section">
<h2>The Mifflin-St Jeor Equation</h2>
<div class="formula-box">Men: BMR = (10 × kg) + (6.25 × cm) − (5 × age) + 5<br>Women: BMR = (10 × kg) + (6.25 × cm) − (5 × age) − 161</div>
<p style="font-size:0.85rem;color:var(--text-muted);"><em>Disclaimer: Estimates only, not medical advice.</em></p>
</section>
</CalculatorLayout>
