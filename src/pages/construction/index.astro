---
import BaseLayout from '../../layouts/BaseLayout.astro';
import allTools from '../../data/tools.json';
const tools = allTools.filter((tool) => tool.href.startsWith('/construction/'));
---
<BaseLayout title="Construction Calculators - Area & Materials" description="Free construction calculators: square footage, concrete, paint, tile, and more. Estimate materials and costs for DIY and construction projects. No sign-up.">
  <div class="container">
    <div class="page-head">
      <nav class="breadcrumb"><a href="/">Home</a><span class="sep">/</span><span>Construction</span></nav>
      <h1>Construction Calculators</h1>
      <p class="subtitle">Estimate materials, coverage, and costs for construction and DIY projects.</p>
    </div>
    <div class="tool-grid">
      {tools.map((t) => (
        <a href={t.href} class="tool-card">
          <span class="tc-icon" style="background:#fef3c7;color:#b45309;">{t.icon}</span>
          <span><span class="tc-title">{t.name}</span><span class="tc-desc">{t.desc}</span></span>
        </a>
      ))}
    </div>
    <section class="content-section" style="margin-top:32px;">
      <h2>Plan Your Projects Accurately</h2>
      <p>Our construction calculators help you estimate materials before you start — saving time, money, and trips to the hardware store. From concrete and paint to tiles and square footage, get instant, accurate estimates for any project size.</p>
    </section>
    <section class="content-section"><h2>Measure first, then estimate materials</h2><p>Start with the <a href="/construction/square-footage-calculator">square footage calculator</a> to check area. For a rectangular slab, the <a href="/construction/concrete-calculator">concrete calculator</a> adds depth and an adjustable allowance to estimate cubic yards and bags. For walls, the <a href="/construction/paint-calculator">paint calculator</a> uses coat count and your product's coverage. These tools estimate quantities; project design and product instructions determine the specifications you should enter.</p></section>
  </div>
</BaseLayout>
