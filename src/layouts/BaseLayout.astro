---
import '../styles/global.css';
import { externalServicesEnabled, adClient } from '../config/advertising.js';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: object | object[];
  ogType?: string;
  noindex?: boolean;
  showAds?: boolean;
}

const {
  title,
  description,
  canonical,
  schema,
  ogType = 'website',
  noindex = false,
  showAds = true
} = Astro.props;

const externalServices = externalServicesEnabled({ ...import.meta.env, VERCEL_ENV: process.env.VERCEL_ENV });
const siteUrl = 'https://www.kodatools.com';
const canonicalUrl = canonical || new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', siteUrl).href;
const fullTitle = title.includes('KodaTools') ? title : `${title} | KodaTools`;

const navItems = [
  { href: '/finance', label: 'Finance' },
  { href: '/health', label: 'Health' },
  { href: '/math', label: 'Math' },
  { href: '/construction', label: 'Construction' },
  { href: '/date-time', label: 'Date & Time' },
  { href: '/converters', label: 'Converters' },
  { href: '/everyday', label: 'Everyday' },
];

const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <meta name="theme-color" content="#0f766e" />
  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="KodaTools" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />

  <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  {schema && (
    Array.isArray(schema)
      ? schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)
      : <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  )}

  <!-- Google AdSense -->
  {externalServices && showAds && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adClient}`} crossorigin="anonymous"></script>}

  <!-- Google Analytics (gtag.js) -->
  {externalServices && <script async src="https://www.googletagmanager.com/gtag/js?id=G-4PKY9KBW0E"></script>}
  {externalServices && <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-4PKY9KBW0E');
  </script>}
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="logo">
        <span class="logo-mark">K</span>
        Koda<span class="brand-accent">Tools</span>
      </a>
      <nav class="main-nav" aria-label="Main categories">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={currentPath.startsWith(item.href) ? 'active' : ''}
            aria-current={currentPath.startsWith(item.href) ? 'location' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </div>
  </header>

  <main id="main-content" tabindex="-1">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/" class="logo">
            <span class="logo-mark">K</span>
            Koda<span class="brand-accent">Tools</span>
          </a>
          <p>Free online calculators and everyday tools. Fast, accurate, and always free. No sign-up required.</p>
        </div>
        <div class="footer-col">
          <h4>Finance</h4>
          <a href="/finance/mortgage-calculator">Mortgage Calculator</a>
          <a href="/finance/loan-calculator">Loan Calculator</a>
          <a href="/finance/compound-interest-calculator">Compound Interest</a>
          <a href="/finance/tip-calculator">Tip Calculator</a>
        </div>
        <div class="footer-col">
          <h4>Popular</h4>
          <a href="/math/percentage-calculator">Percentage Calculator</a>
          <a href="/health/bmi-calculator">BMI Calculator</a>
          <a href="/date-time/age-calculator">Age Calculator</a>
          <a href="/health/calorie-calculator">Calorie Calculator</a>
        </div>
        <div class="footer-col">
          <h4>Company</h4>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
          <a href="/privacy-policy">Privacy Policy</a>
          <a href="/terms">Terms of Service</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>&copy; {new Date().getFullYear()} KodaTools. All rights reserved.</span>
        <span>Made for everyone. Always free.</span>
      </div>
    </div>
  </footer>
</body>
</html>
